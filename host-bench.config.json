{
  "runs": 5,
  "timeoutMs": 10000,
  "sites": [
    {
      "name": "vercel",
      "baseUrl": "https://my-app.vercel.app",
      "endpoints": {
        "page": "/",
        "api": "/api/health"
      }
    },
    {
      "name": "railway",
