{
  "name": "host-bench",
  "version": "0.3.1",
  "description": "CLI to benchmark hosting providers (Vercel, Railway, Render, Fly.io) for a dynamic site's performance.",
  "type": "module",
  "bin": {
    "host-bench": "bin/host-bench.js"
  },
  "scripts": {
    "host-bench": "node bin/host-bench.js",
    "bench": "node bin/host-bench.js run",
    "lint": "for f in bin/*.js src/*.js tests/*.js scripts/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "benchmark",
    "hosting",
    "vercel",
    "railway",
    "render",
    "fly-io",
    "performance",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  }
}
